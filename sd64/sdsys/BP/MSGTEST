PROGRAM MSGTEST
* MAB - Test messages.c 
CRT 'HERE WE GO'
*
OPENPATH "/usr/local/sdsys/MESSAGES" TO MSGFV ELSE ABORT "Cannot open MESSAGES"
*
SSELECT MSGFV TO 2 
*
READLIST MSGLIST FROM 2 THEN
*
  MSGCNT = DCOUNT(MSGLIST,@AM)
*
  CRT 'MESSAGE COUNT: ':MSGCNT
*
  FOR I = 1 TO MSGCNT
    IF NUM(MSGLIST<I>) THEN
      MSG = SYSMSG(MSGLIST<I>)
      LNS = DCOUNT(MSG,@FM)
      FOR LN = 1 TO LNS
            * TEST MARKS IN STRING ??
            TXT_CNT = DCOUNT(MSG<LN>, @TM)
            FOR TXT_LN = 1 TO TXT_CNT

                CRT MSGLIST<I>:' ':LN:' ':FIELD(MSG<LN>,@TM,TXT_LN)
            NEXT TXT_LN
      NEXT LN
    END 
  NEXT I
*
END
*
CRT 'COMPLETE'
END
