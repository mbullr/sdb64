$internal
$no.symbols
$no.xref
function py_guiwinupdvalues(object_name,key,list_name)
$catalog !py_guiwinupdvalues

$include KEYS.H
$include ERR.H

UpdateArgs = object_name
UpdateArgs<2> = key
UpdateArgs<3> = List_name

STATUS.VALUE = SDEXT(UpdateArgs, @TRUE, SD_PyGuiWinUpdValues)
*
return STATUS.VALUE

end
