   api.lock.record,    ;*  30   Lock a record
   api.clearfile,      ;*  31   Clearfile
   api.filelock,       ;*  32   Get file lock
   api.fileunlock,     ;*  33   Release file lock
   api.recordlocked,   ;*  34   Test lock
