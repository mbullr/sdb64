* Release lock
* In:  fileno (short integer)
*      id

api.release:
   fno = oconv(cmnd[1,2], 'ISL')
   if fno then               ;* 0249
      gosub check.file
      if err then return
   end

   id = cmnd[3,99]

   begin case
      case fno = 0
         release

      case id = ''
         release files(fno)

      case 1
         release files(fno), id
   end case

   return

