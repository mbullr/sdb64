   api.write,          ;*  16   Write record
   api.writeu,         ;*  17   Write record, retaining lock
   api.delete,         ;*  18   Delete record
   api.deleteu,        ;*  19   Delete record, retaining lock
   api.call,           ;*  20   Call catalogued subroutine
   api.execute,        ;*  21   Execute command
   api.respond,        ;*  22   Response to input
   api.endcommand,     ;*  23   End command
   api.login,          ;*  24   Network login
   api.local.login,    ;*  25   SDLocal login
   api.selectindex,    ;*  26   Select index
   api.illegal.action, ;*  27   Enter licensed package - not supported
   api.illegal.action, ;*  28   Exit licensed package  - not supported
