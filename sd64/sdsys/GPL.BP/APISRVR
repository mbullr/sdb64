   api.selectindexk,   ;*  39   Select index, returning keys for value
   api.fileinfo,       ;*  40   Perform FILEINFO() action
   api.readv,          ;*  41   READV and variants
   api.setleft,        ;*  42   Set index at extreme left
   api.setright,       ;*  43   Set index at extreme right
   api.selectleft,     ;*  44   Scan index to left
   api.selectright,    ;*  45   Scan index to right
   api.mark.mapping,   ;*  46   Enable/disable mark mapping
   api.illegal.action

   st = status()
return.status.set: ;* Return to here if ST already set

   if server.error = SV$ON.ERROR then response = @abort.message

* 1.0-3 when logging add command and status 
   if logging then
     logmsg '>command: ': action  
     logmsg '> server.error: ': server.error
     logmsg '> st: ': st
     s = oconv(iconv(server.error, 'ISL'):iconv(st, 'ILL'):response, 'MX0C')
     logmsg '> pkt: ': s[1,4] : ' ' : s[5,8] : ' ' : s[13,10]
   end

   if logging > 1 then
      s = oconv(iconv(server.error, 'ISL'):iconv(st, 'ILL'):response, 'MX0C')
      logmsg '< ' : s[1,4] : ' ' : s[5,8] : ' ' : s[13,1000] 
   end

   
   writepkt iconv(server.error, 'ISL'):iconv(st, 'ILL'):response
until done
