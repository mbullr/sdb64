* Out: record

api.read:
   fno = oconv(cmnd[1,2], 'ISL')
   gosub check.file
   if err then return

   id = cmnd[3,99]
   read rec from files(fno), id
   on error
      server.error = SV$ON.ERROR
   end then
      response = rec
   end else
      server.error = SV$ELSE
   end

   return

