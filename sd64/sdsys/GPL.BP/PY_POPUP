* START-DESCRIPTION:
*
* rtn_stat = PY_POPUP(function_name, popup_name, title_name, title_text, message_name, message_txt, style_name, style_setting)
*
* function_name - name of python function which creates the window 
* title_name, message_name - name of exiting python object to receive associated text, then used to populate popup
* title_text, message_text - text to display in popup
* style_name style_setting  - future use
*                   status() - 0 on success, error code as defined in ERR.H
*                   rtn_stat - same
* END-DESCRIPTION
*
* START-CODE

$internal
$no.symbols
$no.xref
$include SDPYFUNC.H

function py_popup(function_name, popup_name, title_name, title_text, message_name, message_text, style_name, style_setting)
$catalog !py_popup

$include KEYS.H
$include ERR.H

*
* first set the text objects
*

rtn_stat = PY_STRSET(title_name,title_text)
if rtn_stat <> 0 then
  return rtn_stat
end

rtn_stat = PY_STRSET(message_name,message_text)
if rtn_stat <> 0 then
  return rtn_stat
end

begin case
  case style_setting = PY_PUP_OK
    style_text = "PY_PUP_OK"
    
  case style_setting = PY_PUP_YESNO 
    style_text = "PY_PUP_YESNO"
    
  case style_setting = PY_PUP_OKCANCEL 
    style_text = "PY_PUP_OKCANCEL"
    
  case 1
    style_text = "PY_PUP_YESNO"
    
end case  

rtn_stat = PY_STRSET(style_name,style_text)
if rtn_stat <> 0 then
  return rtn_stat
end

UpdateArgs = function_name
UpdateArgs<-1> = popup_name
UpdateArgs<-1> = title_name
UpdateArgs<-1> = message_name
UpdateArgs<-1> = style_name

rtn_stat = SDEXT(UpdateArgs, @TRUE, SD_PyCallFunction)

*
return rtn_stat

end
